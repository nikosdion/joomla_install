# =============================================================================
# Joomla Local Install Configuration
# =============================================================================
# Copy this file to .env and adjust the values to your environment.
# The .env file is NOT committed to the repository.

# -----------------------------------------------------------------------------
# Site configuration
# -----------------------------------------------------------------------------

# The directory where sites will be installed.
# The site slug will be appended to this path.
# Example: SITES_PREFIX=/var/www → site installs to /var/www/bar
SITES_PREFIX=/var/www

# The domain suffix for the site.
# Example: DOMAIN_SUFFIX=example.dev → site accessible at https://bar.example.dev
DOMAIN_SUFFIX=example.dev

# -----------------------------------------------------------------------------
# Database configuration
# -----------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_USER=root
DB_ROOT_PASSWORD=mysupersecretrootpassword

# -----------------------------------------------------------------------------
# Joomla admin user
# -----------------------------------------------------------------------------

ADMIN_FULLNAME="John Doe"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# -----------------------------------------------------------------------------
# Download cache
# -----------------------------------------------------------------------------

# Directory where downloaded Joomla packages are cached.
# Defaults to ~/.cache/joomla-install if left empty.
CACHE_DIR=
